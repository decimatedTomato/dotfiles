alias ali='$EDITOR ~/.alias && source ~/.alias'
alias brc='$EDITOR ~/.bashrc && source ~/.bashrc'
alias zrc='$EDITOR ~/.zshrc && source ~/.zshrc'
alias vrc='$EDITOR ~/.vimrc'
alias gcfg='$EDITOR ~/.gitconfig'
alias tcfg='$EDITOR ~/.tmux.conf && tmux source-file ~/.tmux.conf'

alias lbrc='$EDITOR ~/.bashrc_local && source ~/.bashrc_local'
alias lzrc='$EDITOR ~/.zshrc_local && source ~/.zshrc_local'
alias lvrc='$EDITOR ~/.vimrc_local'
alias lgcfg='$EDITOR ~/.gitconfig_local'
alias ltcfg='$EDITOR ~/.tmux.conf_local && tmux source-file ~/.tmux.conf_local'

alias gs='git status'
alias gd='git diff HEAD'
alias gb='git branch'
alias gl='git log --pretty=oneline'

alias ll="ls -al"
alias la="ls -a"

alias python="python3"
alias py="python3"
alias v='source ./venv/bin/activate'
alias vv='python -m venv venv && v'

alias sanetree='tree -a -I '\''venv|node_modules|build|target|.git'\'' --gitignore'
alias cmake_grep='grep -r --exclude-dir build --include '\''*.cmake'\'' --include '\''CMakeLists.txt'\'
# Wish for an alias or function that shows a diff between a file and a file after its swap file is applied

