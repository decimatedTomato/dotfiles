alias ali='$EDITOR ~/.alias && source ~/.alias'
alias brc='$EDITOR ~/.bashrc && [[ $SHELL == "/bin/bash" ]] && source ~/.bashrc'
alias zrc='$EDITOR ~/.zshrc && [[ $SHELL == "/bin/zsh" ]] && source ~/.zshrc'
alias vrc='$EDITOR ~/.vimrc'
alias gcfg='$EDITOR ~/.gitconfig'
alias tcfg='$EDITOR ~/.tmux.conf && tmux source-file ~/.tmux.conf'

alias lbrc='$EDITOR ~/.bashrc_local && [[ $SHELL == "/bin/bash" ]] && source ~/.bashrc_local'
alias lzrc='$EDITOR ~/.zshrc_local && [[ $SHELL == "/bin/zsh" ]] && source ~/.zshrc_local'
alias lvrc='$EDITOR ~/.vimrc_local'
alias lgcfg='$EDITOR ~/.gitconfig_local'
alias ltcfg='$EDITOR ~/.tmux.conf_local && tmux source-file ~/.tmux.conf_local'

alias gs='git status'
alias gd='git diff HEAD'
alias gb='git branch'
alias gl='git log --pretty=oneline'
alias gcp='git cherry-pick'

alias ll='ls -al'
alias lh='ls -alh'
alias la='ls -a'

alias python='python3'
alias py='python3'
alias v='source ./venv/bin/activate || source ./.venv/bin/activate'
alias vv='python -m venv venv && v'

up() { printf -v blank '%*s' "${1:-1}" ' '; cd ${blank// /..\/} || return; }
cdls() { cd "$1" || return; ls; }
cdla() { cd "$1" || return; la; }
cdll() { cd "$1" || return; ll; }
gitroot() { cd $(git rev-parse --show-toplevel); }
mkcd() { mkdir -p "$1"; cd "$1" || return; }
mkedit() { mkdir -p "$(dirname -- "$1")"; $EDITOR "$@"; }
mksh() {
	[[ $1 =~ .*\.sh$ ]] && script="$1" || script="$1".sh
	echo -e '#!/usr/bin/env bash\n' > "$script"
	chmod +x "$script"
 }

alias path='echo -e ${PATH//:/\\n}'
alias sanetree='tree -a -I "venv|node_modules|build|target|.git"'
alias cmakegrep='grep -r --exclude-dir build --include "*.cmake" --include "CMakeLists.txt"'

alias CLEAR="printf '\033[2J\033[3J\033[1;1H'"

alias vimin='vim -'
# For some reason this leaves "^[[2;2R<CR>2R" in the terminal (maybe because of windows.vim)
alias vim_hotreload='vim -c "vnew | wincmd l | 3new | wincmd x | wincmd j | term ++curwin ++kill=term"'
vimhelp() { vim +"help $*" +only; }

